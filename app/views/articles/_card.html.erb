<article class="news-card" data-category="<%= article.category %>"><a class="card-image" href="<%= editorial_article_path(article) %>" aria-label="Ler <%= article.title %>"><%= render "articles/image", article: article %><span class="card-category"><%= article.category %></span></a><div class="card-copy"><div class="article-meta"><time datetime="<%= article.published_at&.iso8601 %>"><%= article.published_at&.strftime("%d.%m.%Y") %></time><span><%= [1, (article.body_text.split.size / 200.0).ceil].max %> min de leitura</span></div><h3><%= link_to article.title, editorial_article_path(article) %></h3><p><%= article.summary.presence || truncate(article.body_text, length: 130) %></p><div class="card-footer"><span><%= article.author %></span><%= link_to "Ler notícia ↗", editorial_article_path(article) %></div></div></article>
