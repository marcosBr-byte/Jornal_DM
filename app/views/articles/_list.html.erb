<section class="dm-wrap newsroom-feed" id="ultimas-noticias" data-live-region><div class="section-heading"><div><span class="section-kicker"><%= current_environment == "fect" ? "DIRETO DO EVENTO" : "ACONTECE NA NOSSA COMUNIDADE" %></span><%= content_tag(local_assigns[:page_heading] ? :h1 : :h2) do %>Últimas notícias<span class="heading-dot">.</span><% end %></div><% if local_assigns[:home] %><%= link_to "Ver todas as notícias ↗", editorial_articles_path, class: "text-action" %><% end %></div>
<div class="category-tabs" aria-label="Categorias"><%= link_to editorial_articles_path, class: class_names("category-tab", "is-selected" => params[:category].blank?), aria: {current: params[:category].blank? ? "true" : nil} do %><%= ui_icon(:dashboard) %><span>Todas</span><% end %><% Article.category_names(current_environment).each do |category| %><%= link_to editorial_articles_path(category: category, q: params[:q]), class: class_names("category-tab", "is-selected" => params[:category] == category), aria: {current: params[:category] == category ? "true" : nil} do %><%= category_icon(category) %><span><%= category %></span><% end %><% end %></div>
<% unless local_assigns[:home] %><%= form_with url: editorial_articles_path, method: :get, class: "news-search" do |f| %><%= f.search_field :q, value: params[:q], placeholder: "Qual história você procura?", aria: {label: "Buscar notícias"} %><%= f.select :category, options_for_select([["Todas as categorias", ""]] + Article.category_names(current_environment).map { |name| [name, name] }, params[:category]), {}, aria: {label: "Filtrar por categoria"} %><%= f.select :sort, options_for_select([["Destaques primeiro", ""], ["Mais recentes", "recent"], ["Mais antigas", "oldest"]], params[:sort]), {}, aria: {label: "Ordenar notícias"} %><%= f.submit "Buscar", class: "dm-button" %><% end %><% end %>
<div class="newsroom-columns"><div><div class="news-grid"><% if @articles.empty? %><div class="news-empty"><span class="section-kicker">NOVAS HISTÓRIAS VÊM AÍ</span><h3>Nenhuma notícia encontrada.</h3><p>Acompanhe este espaço para as próximas publicações da equipe.</p></div><% else %><%= render partial: "articles/card", collection: @articles, as: :article %><% end %></div>
<% if @page %><nav class="news-pagination" aria-label="Paginação"><%= link_to "← Anteriores", editorial_articles_path(q: params[:q], category: params[:category], sort: params[:sort], page: @page - 1) if @page > 1 %><span>Página <%= @page %></span><%= link_to "Próximas →", editorial_articles_path(q: params[:q], category: params[:category], sort: params[:sort], page: @page + 1) if @has_next %></nav><% end %></div><%= render "articles/most_commented" %></div></section>
