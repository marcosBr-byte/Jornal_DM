<aside class="admin-sidebar" aria-label="Menu administrativo"><div class="admin-menu-caption">MENU PRINCIPAL</div><nav aria-label="Administração"><% dashboard = controller_path == "admin/dashboard" %><% entries = [[:dashboard, "Visão geral", admin_root_path, dashboard], [:plus, "Nova publicação", dashboard ? "#editorPanel" : new_admin_article_path, controller_path == "admin/articles" && action_name.in?(%w[new create edit update])], [:news, "Publicações", dashboard ? "#managePanel" : admin_articles_path, controller_path == "admin/articles" && action_name == "index"], [:categories, "Categorias", admin_categories_path, controller_path == "admin/categories"], [:heart, "Curtidas", admin_likes_path, controller_path == "admin/likes"], [:comments, "Comentários", admin_comments_path, controller_path == "admin/comments"], [:calendar, "Agenda e eventos", admin_events_path, controller_path == "admin/events"]] %><% entries << [:users, "Usuários e permissões", admin_users_path, controller_path == "admin/users"] if current_user.admin? %><% entries.each do |icon, label, path, active| %><%= link_to path, class: class_names("admin-menu-link", "is-active" => active), aria: {current: active ? "page" : nil} do %><%= ui_icon(icon) %><span><%= label %></span><% end %><% end %></nav><div class="admin-sidebar-signature">JORNAL DM<small>INFORMAÇÃO QUE APROXIMA</small></div></aside>
