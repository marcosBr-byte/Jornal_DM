<section id="admin-categories-content" data-live-region class="dm-wrap dm-section"><h1 class="admin-page-heading"><%= ui_icon(:categories) %>Categorias por ambiente</h1><%= render "admin/shared/environment_filter" %>
<%= form_with url: admin_categories_path, scope: :category, class: "dm-form" do |f| %><%= f.label :environment, "Ambiente" %><%= f.select :environment, allowed_environments.map { |key| [EditorialEnvironment::ENVIRONMENTS[key], key] } %><%= f.label :name, "Nome da categoria" %><%= f.text_field :name, required: true, maxlength: 80 %><%= f.submit "Criar categoria", class: "dm-button" %><% end %>
<% @categories.each do |category| %><div class="dm-panel dm-actions"><strong><%= category.name %></strong> · <%= EditorialEnvironment::ENVIRONMENTS[category.environment] %><%= button_to "Excluir", admin_category_path(category), method: :delete, class: "dm-link", data: {turbo_confirm: "Excluir esta categoria?"} %></div><% end %></section>
