<section id="admin-photos-content" data-live-region class="dm-wrap dm-section"><h1 class="admin-page-heading"><%= ui_icon(:camera) %>Recebimento de fotografias</h1><p>Confira a autorização de uso de imagem antes de aprovar. Apenas fotografias aprovadas podem ser publicadas.</p><%= render "admin/shared/environment_filter" %>
<nav class="dm-actions"><% [["Todas", nil], ["Aguardando análise", "pending"], ["Aprovadas", "approved"], ["Rejeitadas", "rejected"], ["Publicadas", "published"]].each do |label, status| %><%= link_to label, admin_photos_path(status: status, environment: params[:environment]), class: "dm-link" %><% end %></nav>
<div class="dm-grid"><% @photos.each do |photo| %><article class="dm-panel"><%= image_tag admin_photo_path(photo), loading: "lazy", width: photo.width, height: photo.height, alt: photo.caption.presence || "Fotografia recebida", class: "dm-photo" %><h2><%= photo.display_contributor %></h2><p><%= EditorialEnvironment::ENVIRONMENTS[photo.environment] %> · <%= photo.created_at.strftime("%d/%m/%Y %H:%M") %> · <%= editorial_status_label(photo.status) %></p>
<p>Original: <%= number_to_human_size(photo.original_bytes) %> · WebP: <%= number_to_human_size(photo.optimized_bytes) %><br><%= photo.width %> × <%= photo.height %> px</p>
<% if photo.original_bytes.to_i > 0 %><p>Redução real: <%= number_to_percentage(100.0 * (photo.original_bytes - photo.optimized_bytes) / photo.original_bytes, precision: 1) %> (<%= number_to_human_size([photo.original_bytes - photo.optimized_bytes, 0].max) %> economizados).</p><% end %>
<%= form_with model: photo, url: admin_photo_path(photo), class: "dm-form" do |f| %><%= f.label :caption, "Legenda" %><%= f.text_field :caption, maxlength: 220 %><%= f.label :album, "Álbum" %><%= f.text_field :album, maxlength: 120 %><%= f.label :event_id, "Evento relacionado" %><%= f.collection_select :event_id, @selectable_events.fetch(photo.environment, []), :id, :title, include_blank: "Sem evento associado" %><%= f.label :article_id, "Notícia relacionada" %><%= f.collection_select :article_id, @selectable_articles.fetch(photo.environment, []), :id, :title, include_blank: "Sem notícia associada" %><%= f.label :status, "Situação" %><%= f.select :status, [["Aguardando análise", "pending"], ["Aprovada", "approved"], ["Rejeitada", "rejected"]] + (photo.status.in?(%w[approved published]) ? [["Publicada", "published"]] : []) %><%= f.submit "Salvar avaliação", class: "dm-button" %><% end %><%= button_to "Excluir fotografia", admin_photo_path(photo), method: :delete, class: "dm-link", data: {turbo_confirm: "Excluir permanentemente esta fotografia?"} %></article><% end %></div>
<% if @photos.empty? %><p>Nenhuma fotografia neste filtro.</p><% end %>
<div class="dm-actions"><%= link_to "← Anterior", request.query_parameters.merge(page: @page - 1), class: "dm-link" if @page > 1 %><%= link_to "Próxima →", request.query_parameters.merge(page: @page + 1), class: "dm-link" if @photos.size == 24 %></div></section>
