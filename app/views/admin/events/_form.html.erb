<% if @event.errors.any? %><p role="alert"><%= @event.errors.full_messages.to_sentence %></p><% end %>
<%= form_with model: [:admin, @event], class: "dm-form" do |f| %>
<%= f.label :environment, "Ambiente" %><%= f.select :environment, allowed_environments.map { |key| [EditorialEnvironment::ENVIRONMENTS[key], key] } %>
<%= f.label :title, "Nome do evento" %><%= f.text_field :title, required: true, maxlength: 160 %>
<%= f.label :description, "Descrição" %><%= f.text_area :description, rows: 5, maxlength: 5000 %>
<%= f.label :starts_at, "Data e horário (Fortaleza)" %><%= f.datetime_local_field :starts_at, required: true %>
<%= f.label :location, "Local" %><%= f.text_field :location, required: true, maxlength: 160 %>
<%= f.label :category, "Categoria" %><%= f.text_field :category, maxlength: 160 %>
<%= f.label :image, "Imagem do evento" %><%= f.file_field :image, accept: "image/jpeg,image/png,image/webp" %>
<%= f.submit "Salvar evento", class: "dm-button" %><%= link_to "Voltar", admin_events_path, class: "dm-link" %><% end %>
