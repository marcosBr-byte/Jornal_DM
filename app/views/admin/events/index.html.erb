<section id="admin-events-content" data-live-region class="dm-wrap dm-section"><h1 class="admin-page-heading"><%= ui_icon(:calendar) %>Agenda e eventos</h1><%= link_to "Criar evento", new_admin_event_path, class: "dm-button" %><%= render "admin/shared/environment_filter" %>
<% @events.each do |event| %><article class="dm-panel"><h2><%= event.title %></h2><p><%= EditorialEnvironment::ENVIRONMENTS[event.environment] %> · <%= event.starts_at.strftime("%d/%m/%Y às %H:%M") %> · <%= event.location %></p><div class="dm-actions"><%= link_to "Editar", edit_admin_event_path(event), class: "dm-button" %><%= button_to "Excluir", admin_event_path(event), method: :delete, class: "dm-button", data: {turbo_confirm: "Excluir evento?"} %></div></article><% end %><% if @events.empty? %><p>Nenhum evento cadastrado.</p><% end %></section>
