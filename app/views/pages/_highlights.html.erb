<% if @highlights.any? %>
<section class="highlights-section" aria-label="Notícias em destaque" aria-roledescription="carrossel" data-controller="carousel" data-carousel-interval-value="5000" data-action="mouseenter->carousel#hoverPause mouseleave->carousel#hoverResume focusin->carousel#focusPause focusout->carousel#focusResume keydown->carousel#keyboard">
<div class="section-heading"><div><span class="section-kicker">ESCOLHAS DA REDAÇÃO</span><h2>Em destaque<span class="heading-dot">.</span></h2></div><% if @highlights.size > 1 %><div class="carousel-controls"><button type="button" class="icon-button" data-action="carousel#previous" aria-label="Destaque anterior">←</button><button type="button" class="icon-button" data-action="carousel#toggle" data-carousel-target="pause" aria-label="Pausar carrossel" aria-pressed="false">Ⅱ</button><button type="button" class="icon-button" data-action="carousel#next" aria-label="Próximo destaque">→</button></div><% end %></div>
<% @highlights.each_with_index do |article, index| %><article class="featured-slide" data-carousel-target="slide" <%= "hidden" if index > 0 %> aria-label="<%= index + 1 %> de <%= @highlights.size %>"><div class="featured-copy"><span class="category-label"><%= article.category %></span><h3><%= link_to article.title, editorial_article_path(article) %></h3><p><%= article.summary.presence || truncate(article.body_text, length: 190) %></p><div class="article-meta"><span><%= article.author %></span><span><%= article.published_at&.strftime("%d.%m.%Y") %></span></div><%= link_to "Ler reportagem completa ↗", editorial_article_path(article), class: "featured-link" %></div><a class="featured-image" href="<%= editorial_article_path(article) %>" aria-label="Ler <%= article.title %>"><%= render "articles/image", article: article, priority: index == 0 %></a></article><% end %>
<% if @highlights.size > 1 %><div class="carousel-dots" aria-label="Escolher destaque"><% @highlights.each_with_index do |article, index| %><button type="button" data-carousel-target="dot" data-action="carousel#go" data-index="<%= index %>" aria-label="Destaque <%= index + 1 %>: <%= article.title %>" aria-current="<%= index == 0 ? "true" : "false" %>"></button><% end %><span data-carousel-target="status" class="sr-only" aria-live="polite"></span></div><% end %>
</section><% end %>
