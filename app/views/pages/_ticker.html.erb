<section id="news-ticker" data-live-region data-live-ticker data-action="ticker:update->ticker#update" class="news-ticker" aria-label="Principais notícias" data-controller="ticker"><div class="dm-wrap ticker-layout"><strong><span class="live-dot"></span><%= current_environment == "fect" ? "GIRO FECT" : "GIRO DM" %></strong><div class="ticker-window"><div class="ticker-track" data-ticker-target="track"><% if @ticker.any? %><% 2.times do |copy| %><div class="ticker-group" <%= 'aria-hidden=true' if copy == 1 %>><% @ticker.each do |article| %><%= link_to editorial_article_path(article), tabindex: copy == 1 ? -1 : 0 do %><span>✦</span><%= article.title %><% end %><% end %></div><% end %><% else %><span class="ticker-empty">As próximas manchetes da comunidade aparecerão aqui.</span><% end %></div></div><% if @ticker.any? %><button class="ticker-toggle" type="button" data-action="ticker#toggle" aria-label="Pausar manchetes" aria-pressed="false">Ⅱ</button><% end %></div></section>
