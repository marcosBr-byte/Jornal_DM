<div class="news-topbar"><div class="dm-wrap"><span>ESCOLA DOM MARCELO</span><span id="todayLabel"></span></div></div>
<header class="news-header" data-controller="navigation">
  <div class="dm-wrap masthead"><a class="masthead-brand" href="<%= current_environment == "fect" ? fect_path : root_path %>" aria-label="<%= environment_name %> - início"><%= render "shared/journal_logo" %><span><strong><%= environment_name %></strong><small><%= current_environment == "fect" ? "COBERTURA ESPECIAL · CIÊNCIA E CONHECIMENTO" : "O JORNAL DA NOSSA COMUNIDADE" %></small></span></a>
    <div class="masthead-tools"><button type="button" class="dm-mobile-menu-button icon-button" data-action="navigation#toggle" data-navigation-target="button" aria-expanded="false" aria-controls="main-navigation">☰ Menu</button><button type="button" class="icon-button motion-button" data-motion-target="toggle" data-action="motion#toggle" aria-label="Pausar animações" aria-pressed="false" title="Pausar animações">Ⅱ</button><button id="themeToggle" type="button" class="icon-button theme-button" data-theme-target="toggle" data-action="theme#toggle" aria-label="Ativar tema escuro">☾</button><%= link_to admin_root_path, class: "admin-access admin-person", aria: {label: "Acessar painel administrativo"}, title: "Área administrativa" do %><%= ui_icon(:person) %><% end %></div>
  </div>
  <nav aria-label="Navegação principal"><div id="main-navigation" data-navigation-target="menu" class="dm-wrap dm-navigation news-nav"><% navigation = current_environment == "fect" ? [["Início FECT", fect_path], ["Notícias FECT", fect_articles_path], ["Jornal DM", root_path]] : [["Início", root_path], ["Últimas notícias", articles_path], ["Agenda", agenda_path], ["FECT", fect_path]] %><% navigation.each do |label, path| %><%= link_to label, path, class: class_names("news-nav-link", "is-active" => current_page?(path)), aria: {current: current_page?(path) ? "page" : nil} %><% end %><span class="nav-caption"><span class="live-dot"></span> Informação que aproxima</span></div></nav>
</header>
